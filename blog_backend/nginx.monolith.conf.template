events {
    worker_connections 1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;
    sendfile      on;

    server {
        listen ${PORT};

        # Frontend Static Files
        location / {
            root /usr/share/nginx/html;
            try_files $uri /index.html;
        }

        # Unified API Routing - All microservices are now merged into port 8000
        location /api/users/ { proxy_pass http://127.0.0.1:8000; }
        location /api/profile/ { proxy_pass http://127.0.0.1:8000; }
        location /api/follows/ { proxy_pass http://127.0.0.1:8000; }
        location /api/posts/ { proxy_pass http://127.0.0.1:8000; }
        location /api/moderation/ { proxy_pass http://127.0.0.1:8000; }
        location /api/analytics/ { proxy_pass http://127.0.0.1:8000; }
        location /api/timeline/ { proxy_pass http://127.0.0.1:8000; }
        
        location /ws/timeline {
            proxy_pass http://127.0.0.1:8000;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
        }

        location /api/admin/ { proxy_pass http://127.0.0.1:8000; }
        location /api/ml/ { proxy_pass http://127.0.0.1:8000; }
    }
}
